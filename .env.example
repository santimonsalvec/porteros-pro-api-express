# MongoDB connection string backing users, refreshTokens, termsAcceptances, Countries.
# Use your MongoDB Atlas cluster's connection string (mongodb+srv://...) or any other
# reachable MongoDB deployment — no local/Docker MongoDB is required for this project.
MONGODB_CONNECTION_STRING=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Symmetric key used to sign/verify internal access tokens (32+ random bytes). Never commit a real value.
JWT_SIGNING_KEY=replace-with-a-long-random-secret

# Google OAuth client IDs accepted as `aud` per platform.
GOOGLE_CLIENT_ID_MOBILE=
GOOGLE_CLIENT_ID_WEB=

# Token lifetimes (optional; defaults shown).
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Legal document versions recorded on terms acceptance (optional; defaults shown).
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_POLICY_VERSION=1.0

# OpenTelemetry OTLP collector endpoint (optional; falls back to console export when unset).
OTEL_EXPORTER_OTLP_ENDPOINT=

# HTTP port (optional; default shown).
PORT=3000
