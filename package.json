    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "jose": "^5.9.6",
    "mongodb": "^7.6.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "swagger-ui-express": "^5.0.1",
